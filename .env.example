# FPL DOF environment variables.
# Copy to .env and edit. .env is gitignored; this file is committed and must never hold a secret.
# The full table, with the epic each variable is needed by, is in
# docs/planning/epics/INPUTS-REQUIRED.md §8.

# --- E0 (all optional; defaults are in pipeline/src/fpl_dof/config/defaults/) ---
# Execution context: local | ci
FPL_DOF_ENV=local
# Override the data root. Defaults to <repo>/data.
# FPL_DOF_DATA_DIR=
# DEBUG | INFO | WARNING | ERROR
FPL_DOF_LOG_LEVEL=INFO
# Honest client identification (NFR-10). Never a personal address.
FPL_DOF_USER_AGENT_CONTACT=https://github.com/talonegg/fpl_dof2

# --- E1 ---
# Rendering zone only. Storage and computation are UTC everywhere (DL-11).
# FPL_DOF_TIMEZONE=Australia/Sydney
# Your FPL entry ID. Public, but it cannot exist until you have created your 2026/27 team.
# FPL_DOF_TEAM_ID=

# --- E5/E6 ---
# FPL_DOF_LEAGUE_ID=
# ODDS_API_KEY is the ONLY secret in the project. It goes here locally and in GitHub Actions
# secrets in CI — never in a settings file, never in the client bundle (NFR-13).
# ODDS_API_KEY=
# FPL_DOF_ODDS_CREDIT_BUDGET=450
