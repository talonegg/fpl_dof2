# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / web
node_modules/
dist/
.vite/
# Published artefacts copied into the app for local serving; regenerate with `fpl-dof publish`.
web/public/data/
# Browser verification output — regenerate with `npm run verify:browser`.
web/verify/screenshots/

# Data (local working data, not committed).
# Anchored to the repository root on purpose: an unanchored `data/` matches *any* directory of that
# name at any depth, which silently swallowed the whole of `web/src/data/` — the app's data layer —
# so E6-S1's `DataProvider.tsx` and `published.ts` were never actually tracked. A gitignore rule that
# hides source is exactly the kind of failure nothing goes red for.
/data/
*.parquet
*.duckdb

# Environment / secrets
.env
.env.*
!.env.example
*.local

# Local configuration override (layer 2 of the config loader)
config/local.yaml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
