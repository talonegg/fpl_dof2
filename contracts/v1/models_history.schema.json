{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talonegg/fpl_dof2/contracts/v1/models_history.schema.json",
  "title": "ModelsHistory",
  "description": "How every registered strategy would have played an archive season in the standing backtest (FPL auto-subs, vice-captain fallback, hits, no chips), each on its own fresh squad, scored by the one realised-points scorer. A backtest, not real play. Simulated by the weekly `fpl-dof backtest`, recorded on the `ledger` branch under `models_history/`, and the latest season published by `fpl-dof publish` (ORC-06). The same shape, `kind` `as_if_played`, is the live season as if each strategy had played it, published as `as_if_played.json` with each gameweek labelled replayed or live (ORC-13).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "season", "kind", "caveat", "champion", "provenance", "bootstrap", "models", "gameweeks", "summary"],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "season": { "type": "string" },
    "kind": { "type": "string", "enum": ["backtest", "as_if_played"], "description": "backtest: an archive season (models_history.json). as_if_played: the live season (as_if_played.json)." },
    "caveat": { "type": "string" },
    "champion": { "type": "string" },
    "provenance": {
      "type": "object",
      "description": "Where the numbers came from: the backtest run, its config digest, the simulator, the scorer and the settings.",
      "additionalProperties": { "type": "string" }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draws", "seed", "unit", "level"],
      "properties": {
        "draws": { "type": "integer" },
        "seed": { "type": "integer" },
        "unit": { "type": "string" },
        "level": { "type": "number" }
      }
    },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model_history_model" } },
    "gameweeks": { "type": "array", "items": { "$ref": "#/$defs/model_history_gameweek" } },
    "summary": { "type": "array", "items": { "$ref": "#/$defs/model_history_summary" } }
  },
  "$defs": {
    "model_history_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "available", "unavailable_reason"],
      "properties": {
        "id": { "type": "string", "description": "The strategy's id in the strategy registry (strategies.json); a file built before the registry carries one of its legacy aliases." },
        "label": { "type": "string" },
        "role": { "type": "string", "description": "The strategy's registry role; a file built before the registry says comparison for a challenger." },
        "available": { "type": "boolean" },
        "unavailable_reason": { "type": ["string", "null"] },
        "live_from": { "type": ["integer", "null"], "description": "as_if_played only: the first gameweek the live record holds this strategy's advice; null when it has never advised live. Absent in models_history.json." }
      }
    },
    "model_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "points_before_hits", "hit_points", "n_transfers", "transfers", "captain", "vice_captain", "captain_points", "vice_used", "n_autosubs", "cumulative", "rank", "cumulative_rank"],
      "properties": {
        "points": { "type": "number", "description": "Final XI after auto-subs, armband (vice fallback), net of hits." },
        "points_before_hits": { "type": "number" },
        "hit_points": { "type": "number" },
        "n_transfers": { "type": "integer", "minimum": 0 },
        "transfers": { "type": "array", "items": { "type": "string" } },
        "captain": { "type": "string" },
        "vice_captain": { "type": "string" },
        "captain_points": { "type": "number" },
        "vice_used": { "type": "boolean" },
        "n_autosubs": { "type": "integer", "minimum": 0 },
        "cumulative": { "type": "number" },
        "rank": { "type": "integer", "minimum": 1 },
        "cumulative_rank": { "type": "integer", "minimum": 1 },
        "record": { "type": "string", "enum": ["replayed", "live"], "description": "as_if_played only: replayed before the strategy went live (live_from), live from it. Absent in models_history.json." }
      }
    },
    "model_history_gameweek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameweek", "models"],
      "properties": {
        "gameweek": { "type": "integer", "minimum": 1 },
        "models": { "type": "object", "additionalProperties": { "$ref": "#/$defs/model_history_entry" } }
      }
    },
    "model_history_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "ci_low", "ci_high", "total", "significant", "gameweeks_better", "gameweeks_worse"],
      "properties": {
        "mean": { "type": "number" },
        "ci_low": { "type": "number" },
        "ci_high": { "type": "number" },
        "total": { "type": "number" },
        "significant": { "type": "boolean", "description": "The 95% CI excludes zero. One season; not a decision rule." },
        "gameweeks_better": { "type": "integer" },
        "gameweeks_worse": { "type": "integer" }
      }
    },
    "model_history_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "total", "mean_per_gameweek", "gameweeks_won", "hit_points", "final_rank", "delta_vs_champion"],
      "properties": {
        "model": { "type": "string" },
        "total": { "type": "number" },
        "mean_per_gameweek": { "type": "number" },
        "gameweeks_won": { "type": "integer", "description": "Gameweeks ranked first among the strategies (ties shared)." },
        "hit_points": { "type": "number" },
        "final_rank": { "type": "integer", "minimum": 1 },
        "delta_vs_champion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/model_history_delta" }] }
      }
    }
  }
}
