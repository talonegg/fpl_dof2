{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talonegg/fpl_dof2/contracts/v1/squad.schema.json",
  "title": "Squad",
  "description": "The recommended squad, its lineup, and how it was arrived at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "status",
    "objective",
    "total_price",
    "formation",
    "captain_id",
    "vice_captain_id",
    "bench_order",
    "players"
  ],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["optimal", "greedy_fallback", "skipped"],
      "description": "A greedy fallback is legal but not optimal, and the app says so. Skipped means nothing was solved: in-season the from-scratch squad is not the decision (DL-67), and players is empty."
    },
    "skipped": {
      "type": "boolean",
      "description": "True when the from-scratch solve did not run this gameweek (DL-67). The app then starts from this week's advised squad in week.json instead."
    },
    "skipped_reason": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["solver", "week_advice"],
      "description": "Where these fifteen came from. The pipeline always writes solver output; the app sets week_advice when it substitutes this week's advised squad for a skipped solve (DL-67)."
    },
    "objective": { "type": "number" },
    "solve_seconds": { "type": "number", "minimum": 0 },
    "total_price": { "type": "number", "minimum": 0 },
    "budget": { "type": "number", "exclusiveMinimum": 0 },
    "formation": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "description": "Starters per position, keyed by position code."
    },
    "captain_id": { "type": ["integer", "null"], "minimum": 1 },
    "vice_captain_id": { "type": ["integer", "null"], "minimum": 1 },
    "bench_order": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "Outfield substitutes, in the order they come on."
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "player_id",
          "web_name",
          "position",
          "team",
          "team_id",
          "price",
          "xp_next",
          "xp_horizon",
          "starting",
          "is_captain",
          "is_vice_captain"
        ],
        "properties": {
          "player_id": { "type": "integer", "minimum": 1 },
          "web_name": { "type": "string" },
          "position": { "type": "string", "enum": ["GKP", "DEF", "MID", "FWD"] },
          "team": { "type": "string" },
          "team_id": { "type": "integer", "minimum": 1 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "xp_next": { "type": "number" },
          "xp_next_sd": { "type": "number", "minimum": 0 },
          "xp_horizon": { "type": "number" },
          "xp_horizon_sd": { "type": "number", "minimum": 0 },
          "start_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low", "none"] },
          "starting": { "type": "boolean" },
          "is_captain": { "type": "boolean" },
          "is_vice_captain": { "type": "boolean" },
          "components": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    }
  }
}
