{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talonegg/fpl_dof2/contracts/v1/week.schema.json",
  "title": "Week",
  "description": "This week's decision: the deadline, the squad as it stands, what to do, and why. Times are UTC on the wire; the browser renders local zones itself (DL-11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "skipped", "deadline"],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "as_of": { "type": "string", "format": "date-time", "description": "UTC instant of the input snapshot the advice was decided on (ORC-03, DL-94). Absent before R1.3.0." },
    "trigger": { "type": "string", "pattern": "^(manual|schedule|day-before|change:(prices|status|fixtures|odds)(,(prices|status|fixtures|odds))*)$", "description": "What started the run: the schedule, a change of the named kinds, a manual dispatch or the day-before refresh (ORC-03). Absent before R1.3.0." },
    "skipped": {
      "type": "boolean",
      "description": "True when no squad could be established. Before the first gameweek is scored there is no picks endpoint to read (DL-20), so this is a normal state and not a failure."
    },
    "skipped_reason": { "type": "string" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role"],
      "description": "Which strategy produced this recommendation. week.json is the champion's (the live advice); every other published strategy writes week_<id>.json in the same schema, at the path strategies.json names.",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "role": { "type": "string", "enum": ["champion", "challenger", "experiment", "retired"], "description": "The strategy's registry role, as strategies.json lists it." }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "description": "The registered strategy that produced this advice: its id in the strategy registry (strategies.json) and its digest (MOD-03): sha256 over the registry entry, the source that decides its advice and the run config it reads.",
      "properties": {
        "id": { "type": "string" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameweek", "name", "deadline_utc", "decide_by_utc", "local_zone", "uk_zone"],
      "properties": {
        "gameweek": { "type": "integer", "minimum": 1, "maximum": 38 },
        "name": { "type": "string" },
        "deadline_utc": {
          "type": "string",
          "format": "date-time",
          "description": "UTC. The offset between UK and local time changes twice a season and not on the same dates, so anything that reasons in local time is wrong for part of the year."
        },
        "decide_by_utc": {
          "type": "string",
          "format": "date-time",
          "description": "Deliberately earlier than the deadline. Most deadlines land between 02:30 and 05:00 local, so the practical rule is to decide the evening before."
        },
        "local_zone": { "type": "string" },
        "uk_zone": { "type": "string" }
      }
    },
    "last_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "reason"],
      "description": "This run's strategy failed after an earlier success for the gameweek; the file shows that success, the advice of record, stamped with its own as_of (ORC-03, DL-94). Absent when this run succeeded.",
      "properties": {
        "as_of": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      }
    },
    "arrived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "at"],
      "description": "The source this strategy waited for arrived and the strategy was refreshed with it: it had no advice for the gameweek in the ledger's record because the source's data was missing, and advises in this run, whatever started it; the file's trigger says what did (ORC-07). Absent otherwise, and gone from the next run's file.",
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" }, "description": "The awaited sources' labels, as the data health page names them." },
        "at": { "type": "string", "format": "date-time", "description": "UTC instant of the snapshot the source arrived in." }
      }
    },
    "squad_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "bank", "sell_value", "budget", "free_transfers"],
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["from_picks", "reconstructed", "declared"],
          "description": "How much was read versus inferred. Reported, never hidden."
        },
        "entry_id": { "type": ["integer", "null"] },
        "as_of_gameweek": { "type": ["integer", "null"] },
        "bank": { "type": "number", "minimum": 0 },
        "sell_value": {
          "type": "number",
          "minimum": 0,
          "description": "What the squad would raise, after the sell-on fee. Not the same as its value at current prices."
        },
        "budget": { "type": "number", "minimum": 0 },
        "free_transfers": { "type": "integer", "minimum": 0 },
        "chips_used": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "is_roll", "transfers", "hit_points", "net_expected_points"],
      "properties": {
        "rationale": { "type": "string" },
        "is_roll": {
          "type": "boolean",
          "description": "Doing nothing is a first-class option with a number attached, not the absence of a recommendation (FR-24)."
        },
        "transfers": { "type": "integer", "minimum": 0 },
        "hit_points": { "type": "integer", "maximum": 0 },
        "net_expected_points": { "type": "number" },
        "gain_over_roll": { "type": "number" },
        "bank_after": { "type": "number" },
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["out", "in"],
            "properties": {
              "out": { "$ref": "#/$defs/move_side" },
              "in": { "$ref": "#/$defs/move_side" }
            }
          }
        },
        "options": {
          "type": "array",
          "description": "Every course of action considered, including the roll, each with its own arithmetic.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transfers", "hit_points", "net_expected_points", "gain_over_roll"],
            "properties": {
              "transfers": { "type": "integer", "minimum": 0 },
              "hit_points": { "type": "integer", "maximum": 0 },
              "net_expected_points": { "type": "number" },
              "gain_over_roll": { "type": "number" },
              "moves": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "option_set": { "$ref": "#/$defs/log_hindsight_optimal", "description": "What this model weighed on its own predicted xP, in the hindsight optimum's shape: the roll, the best single transfer and the best overall, each with its moves, captain, points before hits, hits, net and gain over roll (ORC-11). Recorded with the advice in the ledger. Absent before R1.4.0." },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "advised": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameweek", "squad", "starting", "captain", "vice_captain"],
      "properties": {
        "gameweek": { "type": "integer", "minimum": 1, "maximum": 38 },
        "squad": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "starting": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "bench_order": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "reserve_goalkeeper": { "type": ["integer", "null"] },
        "captain": { "type": "integer", "minimum": 1 },
        "vice_captain": { "type": "integer", "minimum": 1 },
        "formation": { "type": "string" },
        "expected_points": { "type": "number" }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "urgent"] },
          "category": { "type": "string" },
          "message": { "type": "string" },
          "player_id": { "type": ["integer", "null"] },
          "detail": { "type": "object" }
        }
      }
    },
    "reconciliation": {
      "type": ["object", "null"],
      "description": "What was advised against what was actually played, for the previous gameweek. An unexplained difference usually means a submission error (E1-S5).",
      "additionalProperties": false,
      "required": ["gameweek", "entry_id", "followed"],
      "properties": {
        "gameweek": { "type": "integer", "minimum": 1, "maximum": 38 },
        "entry_id": { "type": "integer", "minimum": 1 },
        "followed": { "type": "boolean" },
        "advised": { "type": "object" },
        "played": { "type": "object" },
        "divergences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status", "message"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["squad", "starting", "captain", "vice_captain", "bench_order"]
              },
              "status": { "type": "string", "enum": ["override", "unexplained"] },
              "message": { "type": "string" },
              "advised": { "type": "array", "items": { "type": "integer" } },
              "played": { "type": "array", "items": { "type": "integer" } },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "move_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id", "web_name", "price"],
      "properties": {
        "player_id": { "type": "integer", "minimum": 1 },
        "web_name": { "type": "string" },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "xp_next": { "type": "number", "description": "The forecast's side of the disagreement (DL-70)." },
        "form_points_per_match": {
          "type": ["number", "null"],
          "description": "The model-free benchmark's side: points per match over the last six appearances, null before the player has appeared (DL-70)."
        }
      }
    },
    "log_hindsight_optimal": {
      "type": "object",
      "description": "Every option a transfer solve weighed: the roll, the best single transfer and the best overall. The hindsight solves it on realised points (whole); each model's decision on its predicted xP (ORC-11). The same definition is in week.schema.json and models.schema.json, and the type generator fails if they differ.",
      "additionalProperties": false,
      "required": [
        "gameweek",
        "baseline_roll",
        "optimal_single",
        "optimal_overall",
        "all_options"
      ],
      "properties": {
        "gameweek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 38
        },
        "baseline_roll": {
          "$ref": "#/$defs/log_hindsight_plan"
        },
        "optimal_single": {
          "oneOf": [
            {
              "$ref": "#/$defs/log_hindsight_plan"
            },
            {
              "type": "null"
            }
          ]
        },
        "optimal_overall": {
          "$ref": "#/$defs/log_hindsight_plan"
        },
        "all_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/log_hindsight_plan"
          }
        }
      }
    },
    "log_hindsight_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfers_count",
        "moves",
        "starting",
        "captain_id",
        "captain_name",
        "points_before_hits",
        "hit_points",
        "net_points",
        "gain_over_roll"
      ],
      "properties": {
        "transfers_count": {
          "type": "integer",
          "minimum": 0
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "player_out_id",
              "player_out_name",
              "player_in_id",
              "player_in_name",
              "selling_price",
              "buying_price"
            ],
            "properties": {
              "player_out_id": {
                "type": "integer",
                "minimum": 1
              },
              "player_out_name": {
                "type": "string"
              },
              "player_in_id": {
                "type": "integer",
                "minimum": 1
              },
              "player_in_name": {
                "type": "string"
              },
              "selling_price": {
                "type": "number"
              },
              "buying_price": {
                "type": "number"
              }
            }
          }
        },
        "starting": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "captain_id": {
          "type": "integer",
          "minimum": 1
        },
        "captain_name": {
          "type": "string"
        },
        "points_before_hits": {
          "type": "number"
        },
        "hit_points": {
          "type": "integer"
        },
        "net_points": {
          "type": "number"
        },
        "gain_over_roll": {
          "type": "number"
        }
      }
    }
  }
}
