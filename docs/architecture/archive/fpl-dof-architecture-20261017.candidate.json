  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-Cost Serverless Core",
      "items": [
        "GitHub Actions runs the Python pipeline on cron without persistent servers",
        "GitHub Pages hosts pre-rendered v1 JSON contracts and React 18 SPA at zero cost"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data Ingestion & MILP Optimization",
      "items": [
        "Bronze HTTP snapshots with politeness rate-limiting and retry backoff",
        "Silver Parquet storage validated on read/write with Pandera schemas",
        "Multi-gameweek transfer and squad optimization solved via HighsPy"
      ]
    },
    {
      "dot": "rose",
      "title": "Quality Gates & Client Gate",
      "items": [
        "Invariant 7: Blocking quality gates halt the run before squad solve if data drifts",
        "Client-side SHA-256 password deterrence gate avoids backend authentication overhead"
      ]
    }
