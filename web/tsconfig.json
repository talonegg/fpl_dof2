{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // `node` is here for the build-time and test-time files only — `vite.config.ts` reading
    // `tokens.css`, and the contrast test reading it back. No application module may import a Node
    // built-in; that is a review point, not something the compiler can express.
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
